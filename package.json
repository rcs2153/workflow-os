{
  "name": "workflow-os",
  "version": "0.4.0-preview.1",
  "private": true,
  "description": "Open-source continuity-of-authority kernel for governed agentic work across people, agents, processes, and execution frameworks.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "npm run build:check-kernel && npm run check:docs && npm run check:dogfood && npm run test:integration-helper && npm run test:release-package && npm run test:candidate-workflow && npm run test:release-state && npm run check:ts && npm run check:contracts",
    "build:check-kernel": "cargo build -p workflow-cli --bin workflow-os",
    "check:contracts": "npm run build --workspace @workflow-os/sdk-typescript && node scripts/check-contracts.mjs",
    "check:docs": "node scripts/check-docs.mjs && node scripts/check-release-state.mjs",
    "check:dogfood": "npm run test:dogfood-helper && node --test scripts/claude-fixture-mcp.test.mjs",
    "check:integrations": "node scripts/check-integrations.mjs",
    "check:ts": "npm run typecheck --workspace @workflow-os/sdk-typescript && npm run lint --workspace @workflow-os/sdk-typescript && npm run test --workspace @workflow-os/sdk-typescript",
    "dogfood:benchmark": "node scripts/self-governed-benchmark.mjs",
    "package:release": "node scripts/package-release.mjs",
    "smoke:ci-live": "node scripts/smoke-live-integrations.mjs ci",
    "smoke:github-live": "node scripts/smoke-live-integrations.mjs github",
    "smoke:integrations-live": "node scripts/smoke-live-integrations.mjs all",
    "smoke:jira-live": "node scripts/smoke-live-integrations.mjs jira",
    "test:dogfood-helper": "node --test scripts/self-governed-benchmark.test.mjs",
    "test:synthetic-recovery-bridge": "node scripts/check-synthetic-recovery-bridge.mjs",
    "test:integration-helper": "node --test scripts/check-integrations.test.mjs",
    "test:candidate-workflow": "node --test scripts/final-candidate-workflow.test.mjs",
    "test:release-state": "node --test scripts/check-release-state.test.mjs",
    "test:release-package": "node --test scripts/package-release.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
