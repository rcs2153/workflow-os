{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-os.dev/schemas/v0/project.schema.json",
  "title": "Workflow OS v0 Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project"],
  "properties": {
    "schema_version": { "const": "workflowos.dev/v0" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflows": { "type": "string", "default": "workflows" },
        "skills": { "type": "string", "default": "skills" },
        "policies": { "type": "string", "default": "policies" },
        "tests": { "type": "string", "default": "tests" }
      }
    },
    "config": {
      "type": "array",
      "items": { "$ref": "#/$defs/config_overlay" },
      "default": []
    },
    "governance": {
      "$ref": "#/$defs/project_governance"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._\\-/]+$"
    },
    "config_overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment"],
      "properties": {
        "environment": { "type": "string", "minLength": 1 },
        "vars": {
          "type": "array",
          "items": { "$ref": "#/$defs/config_var" },
          "default": []
        }
      }
    },
    "config_var": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string" }
      }
    },
    "project_governance": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "provider_reads": ["authoritative_execution"]
      },
      "properties": {
        "authoritative_execution": {
          "$ref": "#/$defs/authoritative_execution"
        },
        "provider_reads": {
          "$ref": "#/$defs/provider_reads"
        }
      }
    },
    "authoritative_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "local_check_profile"],
      "properties": {
        "profile": { "const": "observe_and_report" },
        "local_check_profile": {
          "const": "workflow_os_project_validation"
        }
      }
    },
    "provider_reads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github_repository_metadata"],
      "properties": {
        "github_repository_metadata": {
          "$ref": "#/$defs/github_repository_metadata_read"
        }
      }
    },
    "github_repository_metadata_read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "endpoint", "access_reference", "resources"],
      "properties": {
        "enabled": { "const": true },
        "endpoint": { "const": "github.com" },
        "access_reference": { "const": "env/WORKFLOW_OS_GITHUB_TOKEN" },
        "resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/github_repository_metadata_resource" }
        }
      }
    },
    "github_repository_metadata_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "repository"],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 39,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
        }
      }
    }
  }
}
